{
  "name": "gateway",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "test": "bun test",
    "test:pipeline": "bun scripts/test-pipeline.ts",
    "test:guardrails": "bun scripts/test-guardrails.ts",
    "smoke": "bun scripts/smoke.ts",
    "smoke:guardrails": "bun scripts/smoke-guardrails.ts",
    "check-types": "bunx tsc --noEmit",
    "build": "bun build index.ts --outdir dist --target bun"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "elysia": "^1.4.29",
    "yaml": "^2.9.0"
  }
}
