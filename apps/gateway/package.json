{
  "name": "@llm-gateway/sdk",
  "version": "0.5.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "test:pipeline": "bun scripts/test-pipeline.ts",
    "test:guardrails": "bun scripts/test-guardrails.ts",
    "seal:prompt-injection-model": "bun scripts/seal-prompt-injection-model.ts",
    "smoke:sdk": "bun scripts/smoke-sdk.ts",
    "smoke:layer2": "bun scripts/smoke-layer2.ts",
    "smoke:layer2:node": "bun run build && node scripts/smoke-layer2-built.mjs",
    "test:prompt-injection-model": "bun scripts/test-prompt-injection-model.ts",
    "check-types": "bun x tsc --noEmit",
    "build": "bun -e 'import { rm } from \"node:fs/promises\"; import { resolve } from \"node:path\"; await rm(resolve(process.cwd(), \"dist\"), { recursive: true, force: true });' && bun x tsc --project tsconfig.build.json",
    "check:package": "bun run build && bun scripts/check-package.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "onnxruntime-node": "1.27.0",
    "yaml": "^2.9.0"
  }
}
