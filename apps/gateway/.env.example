GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3002

MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=replace-me
MODEL_DEFAULT=gpt-4.1-mini
MODEL_TIMEOUT_MS=30000

# Optional. When omitted, guardrails are disabled.
GUARDRAIL_POLICY_PATH=policies/example-policy.yaml

# Local debugging only. Requires x-gateway-debug-provider-request: true.
GATEWAY_DEBUG_EXPOSE_PROVIDER_REQUEST=false

# Used only by the smoke scripts.
GATEWAY_URL=http://localhost:3002
