{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "sourceMap": true,
    "target": "ES2022"
  },
  "include": ["src/**/*.ts"]
}
